# Copy to terraform.tfvars (gitignored) and adjust.
# The API token is passed via environment instead:  $env:TF_VAR_hcloud_token = "..."

project             = "crypto-quant"
environment         = "prod"
location            = "fsn1"
server_type         = "cx22"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
admin_cidrs         = ["203.0.113.10/32"] # your public IP
data_volume_size_gb = 20
repo_ref            = "main"
enable_backups      = false
enable_protection   = true
