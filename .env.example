# Master/Vault address on Hyperliquid that holds USDC collateral (e.g. 0x1234...)
HYPERLIQUID_WALLET_ADDRESS=your_master_wallet_address_here

# Private key of an authorized AGENT WALLET (API Wallet) generated on Hyperliquid frontend.
# NEVER use your master wallet private key here! Agent wallets have NO withdrawal permissions.
HYPERLIQUID_PRIVATE_KEY=your_agent_wallet_private_key_here

USE_TESTNET=True
DERIBIT_BASE_URL=https://www.deribit.com/api/v2

# Safety limits & Execution guards
MAX_ORDER_SIZE_BTC=0.05
DEFAULT_LEVERAGE=5
SLIPPAGE_TOLERANCE_PCT=0.001

# Set to True to submit real orders via CCXTBroker. False = PaperTrader (default).
LIVE_MODE=False

# Discord webhook URL for critical system fault and kill-switch alerts. Leave blank to disable.
DISCORD_WEBHOOK_URL=

# Runtime / observability
# Rich terminal UI. Docker forces False (no TTY); logs then go to stdout.
DASHBOARD_ENABLED=True
# Prometheus exporter port (0 disables). The GEX collector uses 9101 in compose.
METRICS_PORT=9100
# text | json
LOG_FORMAT=text

# docker compose only
# IMAGE_TAG=latest
# DATA_DIR=./data
# LOGS_DIR=./logs
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
