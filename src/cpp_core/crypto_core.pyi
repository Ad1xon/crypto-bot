"""Type stubs for the ``crypto_core`` C++ extension (src/cpp_core/bindings.cpp)."""

from collections.abc import Sequence
from typing import Any, TypeAlias

import numpy as np
import numpy.typing as npt

__version__: str
MAX_DEPTH: int

_FloatArray: TypeAlias = npt.ArrayLike

class OrderBook:
    def __init__(self, depth: int = 20, auto_reset_cvd: bool = True) -> None: ...

    # ingest
    def update_book(self, bids: _FloatArray, asks: _FloatArray, timestamp_ms: int = 0) -> float: ...
    def update_hyperliquid(self, levels: Sequence[Sequence[dict[str, Any]]], timestamp_ms: int = 0) -> float: ...
    def apply_trade(self, price: float, size: float, is_buy: bool, timestamp_ms: int = 0) -> float: ...
    def apply_trades(
        self,
        prices: _FloatArray,
        sizes: _FloatArray,
        is_buy: npt.ArrayLike,
        timestamps_ms: npt.ArrayLike,
    ) -> float: ...
    def reset_cvd(self, value: float = 0.0) -> None: ...
    def reset(self) -> None: ...

    # queries
    @property
    def depth(self) -> int: ...
    @property
    def auto_reset_cvd(self) -> bool: ...
    @property
    def bid_levels(self) -> int: ...
    @property
    def ask_levels(self) -> int: ...
    @property
    def best_bid_price(self) -> float: ...
    @property
    def best_bid_size(self) -> float: ...
    @property
    def best_ask_price(self) -> float: ...
    @property
    def best_ask_size(self) -> float: ...
    @property
    def is_two_sided(self) -> bool: ...
    @property
    def mid_price(self) -> float: ...
    @property
    def spread(self) -> float: ...
    @property
    def microprice(self) -> float: ...
    @property
    def top_imbalance(self) -> float: ...
    @property
    def ofi(self) -> float: ...
    @property
    def cumulative_ofi(self) -> float: ...
    @property
    def cvd(self) -> float: ...
    @property
    def buy_volume(self) -> float: ...
    @property
    def sell_volume(self) -> float: ...
    @property
    def last_trade_price(self) -> float: ...
    @property
    def update_count(self) -> int: ...
    @property
    def trade_count(self) -> int: ...
    @property
    def last_update_ms(self) -> int: ...
    @property
    def last_trade_ms(self) -> int: ...
    def depth_imbalance(self, levels: int = 20) -> float: ...
    def multi_level_ofi(self, levels: int = 20) -> float: ...
    def ofi_levels(self) -> np.ndarray[Any, np.dtype[np.float64]]: ...
    def bids(self) -> np.ndarray[Any, np.dtype[np.float64]]: ...
    def asks(self) -> np.ndarray[Any, np.dtype[np.float64]]: ...
    def snapshot(self) -> dict[str, float | int]: ...
